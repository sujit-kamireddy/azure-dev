{
    "schemaVersion":  "1.0",
    "extensions":  [
                       {
                           "id":  "azure.ai.rle",
                           "namespace":  "ai.rle",
                           "displayName":  "RLE (Preview)",
                           "description":  "Manage versioned RLE resources from a host-agnostic rle.toml manifest. Set AZD_AI_RLE_ENABLE_ALL=true to preview harness scaffolds and other staged surfaces. (Preview)",
                           "versions":  [
                                            {
                                                "version":  "0.8.18-preview",
                                                "capabilities":  [
                                                                     "custom-commands",
                                                                     "metadata"
                                                                 ],
                                                "usage":  "azd ai rle \u003ccommand\u003e [options]",
                                                "examples":  [
                                                                 {
                                                                     "name":  "init",
                                                                     "description":  "Select a Gym: OpenEnv sample or, with the harness preview flag, scaffold a Harness: HostedAgent or Harness: BYOH RLE.",
                                                                     "usage":  "azd ai rle init [folder-name]"
                                                                 },
                                                                 {
                                                                     "name":  "skill install",
                                                                     "description":  "Install or update RLE project skills from the RLE samples repository.",
                                                                     "usage":  "azd ai rle skill install"
                                                                 },
                                                                 {
                                                                     "name":  "publish",
                                                                     "description":  "Build, push, and publish the RLE release declared in rle.toml.",
                                                                     "usage":  "azd ai rle publish"
                                                                 },
                                                                 {
                                                                     "name":  "run",
                                                                     "description":  "Build and run the local RLE environment container (Gym: OpenEnv only).",
                                                                     "usage":  "azd ai rle run"
                                                                 },
                                                                 {
                                                                     "name":  "rollout",
                                                                     "description":  "Execute one Loom-backed rollout of a published RLE environment (provisions and tears down the Loom session for you; --model falls back to rle.toml\u0027s defaults.model.name).",
                                                                     "usage":  "azd ai rle rollout [environment-name] [--version \u003cmajor.minor.patch\u003e] [--model \u003cloom-base-model\u003e] --task \u003cjson\u003e"
                                                                 },
                                                                 {
                                                                     "name":  "list",
                                                                     "description":  "List RLE environments in a Foundry project.",
                                                                     "usage":  "azd ai rle list"
                                                                 },
                                                                 {
                                                                     "name":  "show",
                                                                     "description":  "Show the details and version history for an RLE environment.",
                                                                     "usage":  "azd ai rle show [environment-name]"
                                                                 }
                                                             ],
